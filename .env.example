# ---------------------------------------------------------------------------
# Pastebin 运行配置
# 复制为 .env 后按需修改。Next.js 服务端（Route Handlers）读取这份文件。
# ---------------------------------------------------------------------------

# 站点名称（同时用于页面标题）
APP_NAME=Pastebin
NEXT_PUBLIC_APP_NAME=Pastebin

# PostgreSQL 连接串：数据库通过它连接，换库只改这一行
# 格式：postgres://用户名:密码@主机:端口/库名
DATABASE_URL=postgres://pastebin:pastebin@127.0.0.1:5432/pastebin
# 托管数据库（Neon/Supabase/RDS 等）要求 TLS 时改成 true
DATABASE_SSL=false

# 本地便携 PostgreSQL（pnpm db:* 脚本使用；连外部数据库时可忽略）
PG_BIN=./.pg/pgsql/bin
PG_DATA=./data/pg
PG_PORT=5432
PG_USER=pastebin
PG_PASSWORD=pastebin
PG_DATABASE=pastebin
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=postgres

# 会话签名 / 解锁令牌密钥，务必改成随机长字符串
# 生成命令：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_DAYS=30

# 通过 HTTPS 部署时改成 true（Cookie 只走加密连接）
COOKIE_SECURE=false

# 单条粘贴的最大字节数（默认 1 MiB）
MAX_PASTE_BYTES=1048576

# 发布频率限制：每 PUBLISH_RATE_WINDOW 秒内，同一个账号（未登录则同一个 IP）
# 最多发布 PUBLISH_RATE_LIMIT 条；设为 0 关闭限制
PUBLISH_RATE_LIMIT=5
PUBLISH_RATE_WINDOW=60
