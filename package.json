{
  "name": "pastebin",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3128",
    "build": "next build",
    "start": "next start -p 3128",
    "lint": "eslint",
    "copy": "cpy \"public/**/*\" .next/standalone/ --base=cwd && cpy \".next/static/**/*\" .next/standalone/ --base=cwd",
    "deploy": "pnpm install && pnpm build && pnpm copy && export PORT=3128 && node .next/standalone/server.js",
    "db:init": "node scripts/pg.mjs init",
    "db:start": "node scripts/pg.mjs start",
    "db:stop": "node scripts/pg.mjs stop",
    "db:status": "node scripts/pg.mjs status",
    "db:ensure": "node scripts/pg.mjs ensure",
    "db:import-sqlite": "node scripts/import-sqlite.mjs",
    "test:api": "node scripts/test-api.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.14.0"
}